# ============================================
# RooMatch Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# DATABASE (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/roomatch?sslmode=require"

# ============================================
# FIREBASE CLIENT (Public - exposed to browser)
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="roomatch-6bde8.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="roomatch-6bde8"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="roomatch-6bde8.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="798053435156"
NEXT_PUBLIC_FIREBASE_APP_ID="1:798053435156:web:a112a5e859d9099d9d2401"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-DWQQ5304LC"

# ============================================
# FIREBASE ADMIN (Server-only - NEVER expose to client)
# ============================================
FIREBASE_PROJECT_ID="roomatch-6bde8"
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@roomatch-6bde8.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# ============================================
# NEXTAUTH (optional - for session fallback)
# ============================================
NEXTAUTH_SECRET="generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
